 "lines": {
  "intro": [
   [
    "h",
    "又一盏。"
   ],
   [
    "h",
    "主灯的光，昨晚被一团黑东西吞了，往城外去了。"
   ],
   [
    "h",
    "再这么黑下去，冷影要爬进城了。"
   ],
   [
    "o",
    "……我去看看。"
   ]
  ],
  "hank": [
   [
    "h",
    "灯塔我看着。你去。"
   ]
  ],
  "hankHome": [
   [
    "h",
    "主灯……亮了。"
   ],
   [
    "h",
    "你肩上那个小东西是谁？"
   ],
   [
    "m",
    "我的！"
   ],
   [
    "o",
    "她说她是莫斯。"
   ]
  ],
  "mossMeet": [
   [
    "",
    "一块苔石正踮着脚摸路灯，摸一盏，叹一口气。"
   ],
   [
    "m",
    "冷的。冷的。这盏也冷的。"
   ],
   [
    "m",
    "你头上那个是热的！"
   ],
   [
    "o",
    "……别摸。"
   ],
   [
    "m",
    "地上有黑黑的印子，我摸到了——那团光往城外的旧灯窖跑了。"
   ],
   [
    "m",
    "那团光是我的！"
   ],
   [
    "o",
    "那是主灯的。"
   ],
   [
    "m",
    "那就一起去拿。"
   ]
  ],
  "dora": [
   [
    "d",
    "我的灯笼不亮了。"
   ],
   [
    "d",
    "荒野里有萤火，能不能帮我抓三只？"
   ]
  ],
  "doraWait": [
   [
    "d",
    "还差几只萤火……"
   ]
  ],
  "doraDone": [
   [
    "d",
    "亮了！"
   ],
   [
    "d",
    "这个给你们，打开它，萤火会帮你们。"
   ]
  ],
  "doraAfter": [
   [
    "d",
    "我的灯笼现在是街上最亮的。"
   ]
  ],
  "lynn": [
   [
    "n",
    "码头上挤满了冷影，我的网都没法补。"
   ],
   [
    "n",
    "帮我赶走它们，我送你们一样好东西。"
   ],
   [
    "n",
    "要买点什么吗？"
   ]
  ],
  "lynnWait": [
   [
    "n",
    "码头那边还有冷影。要买点什么吗？"
   ]
  ],
  "lynnDone": [
   [
    "n",
    "清干净了？谢谢。这个灯罩是我爷爷的，给你。"
   ]
  ],
  "lynnShop": [
   [
    "n",
    "要买点什么吗？"
   ]
  ],
  "gateLocked": [
   [
    "o",
    "……一个人去，太黑了。"
   ]
  ],
  "stone1": [
   [
    "",
    "石碑上刻着：太阳从不闭眼。"
   ],
   [
    "m",
    "它好累。"
   ]
  ],
  "stone2": [
   [
    "",
    "石碑上刻着：人们在它下面点灯，灯是借太阳的火。"
   ],
   [
    "m",
    "借的要还。"
   ]
  ],
  "stone3": [
   [
    "",
    "石碑上刻着：有一天，一个戴歪王冠的小东西爬上了太阳。"
   ],
   [
    "m",
    "……他偷了火。"
   ],
   [
    "o",
    "所以太阳睡着了。"
   ],
   [
    "",
    "莫斯学会了「我的！」"
   ]
  ],
  "lampFirst": [
   [
    "o",
    "点亮它。歇一下。"
   ]
  ],
  "miniBefore": [
   [
    "",
    "楼梯口蹲着一团特别大的影子。"
   ],
   [
    "m",
    "它坐在我的路上。"
   ]
  ],
  "bossBefore": [
   [
    "",
    "最底层，一团大影蹲在那里，肚子里有光在转。"
   ],
   [
    "o",
    "主灯的光。"
   ],
   [
    "m",
    "我的！"
